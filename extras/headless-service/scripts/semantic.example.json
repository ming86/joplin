{
  "accountId": "personal",
  "baseUrl": "http://127.0.0.1:41184",
  "apiTokenFile": "/run/secrets/joplin-api-token",
  "allowWrites": false,
  "semanticDatabasePath": "/data/personal/semantic.sqlite",
  "semanticKeyRef": "personal/semantic",
  "semantic": {
    "enabled": true,
    "rebuild": false,
    "keyFile": "/run/secrets/semantic-database-key",
    "sqliteModule": "/absolute/runtime/native/headless-native/node_modules/sqlite3",
    "pollMs": 5000,
    "rescanMs": 300000,
    "batchSize": 16,
    "chunks": { "maxBytes": 2400, "overlapBytes": 240 },
    "embedding": {
      "protocol": "openai-embeddings",
      "baseUrl": "http://embedding-service:9000/v1",
      "model": "granite-embedding-311m-multilingual-r2",
      "remoteProcessing": true,
      "allowInsecureHttp": true,
      "apiKeyFile": "/run/secrets/ovms-embedding-api-token",
      "timeoutMs": 30000,
      "maxBatch": 16,
      "space": {
        "id": "granite-embedding-311m-multilingual-r2-384-v1",
        "revision": "ovms-granite-embedding-311m-multilingual-r2-384-v1",
        "dimensions": 384,
        "preprocessingVersion": "title-body-v1",
        "normalization": "l2",
        "documentPrefix": "",
        "queryPrefix": ""
      }
    }
  }
}
