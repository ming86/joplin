{
  "name": "joplin-cloudflare-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sops exec-file --no-fifo --filename secrets.env .sops.env 'wrangler dev --env-file \"{}\" --local-protocol https'",
    "deploy": "sops exec-file --no-fifo --filename secrets.env .sops.env 'wrangler deploy --secrets-file \"{}\"'",
    "test": "node --import tsx --test test/*.test.ts",
    "test:worker": "npm run build && node --test --test-timeout=45000 test/worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime false --strict-vars false",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
