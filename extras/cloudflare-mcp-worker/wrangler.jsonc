{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joplin-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_URL": "https://joplin-mcp.example.com",
    "ALLOWED_GOOGLE_EMAIL": "allowed@example.com"
  },
  // Replace this placeholder with this Worker's own namespace before deployment.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [{ "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // OAuth callback URLs carry short-lived codes and state; log fixed events only.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false } }
}
